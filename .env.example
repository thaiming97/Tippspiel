# ------------------------------------------------------------------
# FF Entertainment – Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` und fülle die Werte aus.
# ------------------------------------------------------------------

# --- Sitzung / Auth (nur für den Organisator-Login) ---
# Zufälliger, langer Geheimstring (z.B. `openssl rand -hex 32`)
AUTH_SECRET=change-me-to-a-long-random-string

# --- Firebase Admin SDK (Service Account) ---
# Aus der Firebase Console: Projekteinstellungen > Dienstkonten > Neuen privaten Schlüssel generieren
FIREBASE_PROJECT_ID=mein-projekt
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mein-projekt.iam.gserviceaccount.com
# Den kompletten Private Key in Anführungszeichen, \n als Zeilenumbruch belassen
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Erster Organisator (nur für scripts/create-admin.ts) ---
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Felix
ADMIN_PASSWORD=bitte-aendern
