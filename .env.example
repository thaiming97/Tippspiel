# ------------------------------------------------------------------
# WM-Tippspiel – Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` und fülle die Werte aus.
# ------------------------------------------------------------------

# --- Sitzung / Auth ---
# Zufälliger, langer Geheimstring (z.B. `openssl rand -hex 32`)
AUTH_SECRET=change-me-to-a-long-random-string

# --- Firebase Admin SDK (Service Account) ---
# Aus der Firebase Console: Projekteinstellungen > Dienstkonten > Neuen privaten Schlüssel generieren
FIREBASE_PROJECT_ID=mein-tippspiel
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mein-tippspiel.iam.gserviceaccount.com
# Den kompletten Private Key in Anführungszeichen, \n als Zeilenumbruch belassen
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Fußball-Ergebnis-API (football-data.org) ---
# Kostenloses Token unter https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=
# Wettbewerbs-Code der WM bei football-data.org (Welt­meisterschaft = WC)
FOOTBALL_DATA_COMPETITION=WC

# --- Automatischer Ergebnis-Sync ---
# Geheimnis, mit dem der Cron-Endpunkt /api/cron/sync geschützt ist
CRON_SECRET=change-me-too

# --- Erst-Admin (nur fuer scripts/create-admin.ts) ---
ADMIN_EMAIL=admin@firma.de
ADMIN_NAME=Admin
ADMIN_PASSWORD=bitte-aendern
