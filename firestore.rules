rules_version = '2';

// Sicherheitsregeln für Firestore.
//
// Das Tippspiel greift ausschließlich serverseitig über das Firebase Admin SDK
// auf die Datenbank zu. Das Admin SDK umgeht diese Regeln. Für Client-Zugriffe
// (Browser) ist deshalb ALLES gesperrt – so können Passwort-Hashes und fremde
// Tipps nicht direkt ausgelesen werden.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
